<apex:page  controller="STG_SettingsManager_CTRL"
    showHeader="true"
    sidebar="false"
    title="{!$Label.stgNPSPSettingsTitle}"
    action="{!onNpspSettingsLoad}"
    docType="html-5.0"
    standardStylesheets="false"
    lightningStylesheets="true">

    <apex:includeScript value="{!URLFOR($Resource.CumulusStaticResources, '/jquery/jquery-3.5.0.min.js')}"/>
    <apex:slds />
    <apex:stylesheet value="{!URLFOR($Resource.CumulusStaticResources, '/npsp-slds/npsp-common.css')}" />

<style>
    /* COMMON CSS FOR ALL SETTINGS PAGES */
    .slds .noborder {
        border: 0;
        box-shadow: none;
    }

    div.slds-tree__item button .chevronright, div.slds-tree__item.collapsed button .chevrondown {
        display: none;
    }

    div.slds-tree__item button .chevrondown, div.slds-tree__item.collapsed button .chevronright {
        display: inline-block;
    }

    .clsLoading {
        z-index: 99;
        position: fixed;
        vertical-align: center;
        horiz-align: center;
        width: 100%;
        height: 100%;
    }

    /* Force the box around section titles to be 16px wider on the left and right to match earlier versions of SLDS */
    .slds-section {
        margin-left: -16px;
        margin-right: -16px;
    }
    .hide {
        display: none;
    }

    /* Settings menu: a collapsed category hides its list, and clicking the category's name toggles it like its button */
    #mynavbar ul[hidden] {
        display: none;
    }

    #mynavbar .slds-tree__branch > a {
        cursor: pointer;
    }

    /* Hide a menu item whose link is hidden by the org's settings, so no empty item is left behind */
    #mynavbar li:has(> a[style*="display:none"]),
    #mynavbar li:has(> a[style*="display: none"]) {
        display: none;
    }

    /* Contain horizontal overflow of wide panels to the content column so the sidebar and headings don't scroll with it (WCAG Reflow) */
    .slds .content {
        min-width: 0;
        overflow-x: auto;
    }
</style>

<script>
    var j$ = jQuery.noConflict();
    var idPanelCurrent = '{!JSINHTMLENCODE(idPanelCurrent)}';
    if (idPanelCurrent == '') idPanelCurrent = 'idPanelHome';
    // Focus only moves to a panel after the page has loaded, so it never jumps on load
    var isPageReady = false;

    // Open or close one category of the settings menu, keeping aria-expanded in step with it
    function setNavGroupExpanded(button, isExpanded) {
        button.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
        j$(button).closest('.slds-tree__branch').toggleClass('collapsed', !isExpanded);
        var group = document.getElementById(button.getAttribute('aria-controls'));
        if (group != null) {
            group.hidden = !isExpanded;
        }
    }

    // page init function
    j$(function () {
        // start with every category collapsed. The category's button toggles it, and so does clicking
        // its name. The handler isn't on the whole row, so screen readers don't announce the row as clickable.
        j$('#mynavbar .slds-tree__branch').each(function () {
            var button = j$('button[aria-controls]', this).get(0);
            setNavGroupExpanded(button, false);
            j$(button).add(j$(this).children('a')).on('click', function () {
                setNavGroupExpanded(button, button.getAttribute('aria-expanded') !== 'true');
            });
        });
        ShowPanel(idPanelCurrent);
        isPageReady = true;
    });

    function ShowPanel(idPanel) {
        var node;
        node = document.getElementById(idPanelCurrent);
        if (node != null) {
            node.style.display =  'none';
        }

        node = document.getElementById(idPanelCurrent + 'Nav');
        if (node != null) {
            node.classList.remove('slds-is-selected');
        }
        j$('#treeheading a, #mynavbar a').removeAttr('aria-current');

        node = document.getElementById(idPanel);
        if (node != null) {
            node.style.display =  'block';
        }

        idPanelCurrent = idPanel;
        node = document.getElementById(idPanelCurrent + 'Nav');
        if (node != null) {
            node.classList.add('slds-is-selected');
            j$('a', node).first().attr('aria-current', 'page');
            // open the category that holds the selected section
            var button = j$(node).closest('ul').prev('.slds-tree__branch').find('button[aria-controls]').get(0);
            if (button != null) {
                setNavGroupExpanded(button, true);
            }
        } else if (idPanelCurrent == 'idPanelHome') {
            j$('#treeheading a').attr('aria-current', 'page');
        }

        // scroll the panel into view
        j$('body').scrollTop(0);

        // when someone picks a section, move focus to its heading so screen readers announce the new panel
        if (isPageReady) {
            focusPanelHeading(idPanelCurrent);
        }

        // save current panel to server?
        // or assume panels maintain this?
        // I added this hoping it would solve going back to
        // the correct tab when a validation error was hit on Save,
        // but for some reason the page reloads with {idPanelCurrent} empty,
        // even though it has been set by this actionFunction before editing the panel.
        if (idPanelCurrent != '{!JSINHTMLENCODE(idPanelCurrent)}') {
            setPanelCurrent(idPanelCurrent);
        }
    }

    // Move focus to the first heading of a panel, or to the panel itself if it has no heading
    function focusPanelHeading(idPanel) {
        var panel = document.getElementById(idPanel);
        if (panel == null) {
            return;
        }
        var target = panel.querySelector('h1') || panel.querySelector('h2, h3') || panel;
        if (!target.hasAttribute('tabindex')) {
            target.setAttribute('tabindex', '-1');
        }
        target.focus();
    }

</script>
